---
// EquipoGrid.astro
import { regidores } from '../data/regidores';
---
<section class="pb-16 pt-4 bg-transparent">
  <div class="max-w-6xl mx-auto px-6">
    
    <div class="mb-12 text-center">
      <h2 class="text-3xl font-extrabold text-brand-700 mb-4 uppercase">
        Candidatos a Regidores
      </h2>
      <span class="text-sm font-bold tracking-widest text-accent-700 bg-accent-50 px-4 py-2 rounded-full uppercase border border-accent-200 shadow-sm">
        Juventud, Capacidad y Experiencia
      </span>
    </div>
      
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
      {regidores.map(miembro => (
        <>
          <div class="bg-white rounded-3xl shadow-sm border border-brand-200 overflow-hidden hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1 flex flex-col">
            <div class="aspect-square bg-gradient-to-br from-brand-50 to-white relative flex items-end justify-center overflow-hidden">
              <!-- Placeholder de ícono en caso de no tener foto cargada aún -->
              <div class="absolute inset-0 flex items-center justify-center text-brand-200">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              </div>
              
              {miembro.foto && (
                <img 
                  src={miembro.foto} 
                  alt={`Foto de ${miembro.nombre}, ${miembro.cargo}`}
                  loading="lazy"
                  decoding="async"
                  class={`card-team-img w-full h-full object-contain object-bottom relative z-10 opacity-0 transition-opacity duration-300 ${miembro.numero === "2" ? "scale-[1.25] origin-bottom" : "scale-105 origin-bottom"}`}
                />
              )}
              
              <div class="absolute top-4 right-4 z-20 bg-accent-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-bold text-xl shadow-md border-2 border-white">
                {miembro.numero}
              </div>
            </div>
            
            <div class="p-6 text-center border-t border-brand-100 relative z-30 bg-white flex flex-col flex-grow justify-between">
              <div>
                <div class="inline-block bg-brand-600 text-white px-4 py-1 rounded-full text-xs font-bold uppercase tracking-wider shadow-sm mb-3">
                  {miembro.cargo}
                </div>
                <h3 class="font-bold text-brand-700 text-xl leading-tight uppercase">{miembro.nombre}</h3>
              </div>
              
              <button 
                class="mt-6 bg-brand-50 text-brand-700 hover:bg-brand-600 hover:text-white border border-brand-200 hover:border-brand-600 transition-colors w-full py-2.5 rounded-full font-bold text-sm shadow-sm"
                onclick={`document.getElementById('modal-${miembro.numero}').showModal()`}
              >
                Ver Perfil
              </button>
            </div>
          </div>

          <!-- Modal Popup -->
          <dialog id={`modal-${miembro.numero}`} class="backdrop:bg-gray-900/70 backdrop:backdrop-blur-sm p-0 rounded-3xl shadow-2xl bg-white w-[90%] max-w-2xl m-auto border-0">
            <div class="relative">
              <!-- Botón de cerrar -->
              <button 
                onclick={`document.getElementById('modal-${miembro.numero}').close()`}
                class="absolute top-4 right-4 z-30 bg-white/80 hover:bg-red-50 hover:text-red-600 text-gray-500 w-10 h-10 rounded-full flex items-center justify-center shadow-sm backdrop-blur-md transition-colors border border-gray-200"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
              </button>
              
              <!-- Encabezado del modal -->
              <div class="flex flex-col sm:flex-row border-b border-brand-100 bg-brand-50/50">
                 <div class="w-full sm:w-1/3 aspect-square sm:aspect-auto bg-gradient-to-br from-brand-50 to-brand-100 flex justify-center items-end relative overflow-hidden">
                   {miembro.foto ? (
                     <img 
                       src={miembro.foto} 
                       alt={`Retrato de ${miembro.nombre}, candidato a ${miembro.cargo}`} 
                       class="w-full h-full object-cover object-top" 
                     />
                   ) : (
                     <div class="w-full h-full flex items-center justify-center text-brand-300">
                        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                     </div>
                   )}
                   <div class="absolute top-4 left-4 bg-accent-600 text-white w-10 h-10 rounded-full flex items-center justify-center font-black text-xl shadow-md border-2 border-white">
                     {miembro.numero}
                   </div>
                </div>
                <div class="w-full sm:w-2/3 p-6 sm:p-8 flex flex-col justify-center">
                  <span class="text-brand-600 font-bold text-xs tracking-widest uppercase mb-2">{miembro.cargo}</span>
                  <h3 class="font-extrabold text-brand-800 text-2xl sm:text-3xl leading-tight uppercase">{miembro.nombre}</h3>
                </div>
              </div>
              
              <!-- Contenido del modal -->
              <div class="p-6 sm:p-8 bg-white max-h-[55vh] overflow-y-auto">
                {miembro.descripcion && miembro.descripcion.length > 0 && (
                  <ul class="mb-6 space-y-3">
                    {miembro.descripcion.map(item => (
                      <li class="flex items-start gap-3">
                        <svg class="w-5 h-5 text-brand-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span class="text-gray-700 font-medium text-sm sm:text-base leading-relaxed">{item}</span>
                      </li>
                    ))}
                  </ul>
                )}
                
                {miembro.resumen && (
                  <div class="text-gray-600 text-sm sm:text-base leading-relaxed whitespace-pre-line border-l-4 border-accent-400 pl-4 italic bg-accent-50/30 py-3 pr-3 rounded-r-lg">
                    {miembro.resumen}
                  </div>
                )}
              </div>
            </div>
          </dialog>
        </>
      ))}
    </div>

  </div>
</section>

<style>
  /* Deshabilita el scroll de la página cuando el modal está abierto */
  body:has(dialog[open]) {
    overflow: hidden;
  }
  
  /* Animación suave al abrir el modal */
  dialog[open] {
    animation: modalSlideIn 0.3s ease-out forwards;
  }
  
  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }
</style>

<script>
  // Reemplaza el onload inline: muestra imágenes de regidores al cargar
  // Compatible con ViewTransitions usando astro:page-load
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.card-team-img').forEach((el) => {
      const img = el as HTMLImageElement;
      if (img.complete) {
        img.classList.remove('opacity-0');
      } else {
        img.addEventListener('load', () => img.classList.remove('opacity-0'));
      }
    });
  });
</script>
