---
import { ejes } from '../data/propuestas';
---

<section class="pb-20 pt-4">
    <div class="max-w-7xl mx-auto px-6">

        <div class="grid lg:grid-cols-2 gap-8">
            {ejes.map((eje) => (
                <div class="bg-white rounded-3xl p-8 border border-brand-100 shadow-sm hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
                    <div class="flex items-center gap-5 mb-6 border-b border-brand-50 pb-6">
                        <div class="w-16 h-16 rounded-2xl bg-brand-50 flex items-center justify-center shadow-sm shrink-0" set:html={eje.icono} />
                        <h3 class="text-2xl font-extrabold text-brand-700">
                            {eje.titulo}
                        </h3>
                    </div>

                    <div class="flex flex-col sm:flex-row sm:flex-wrap gap-y-4 gap-x-4">
                        {eje.propuestas.map((item) => (
                            <div class="flex gap-3 items-start group w-full sm:w-[calc(50%-0.5rem)]">
                                <div class="w-6 h-6 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center font-bold shrink-0 mt-0.5 group-hover:bg-accent-600 group-hover:text-white transition-colors duration-300">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                                </div>
                                <p class="text-gray-700 text-sm leading-relaxed font-medium">
                                    {item}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            ))}
        </div>

        <div class="mt-20 rounded-3xl bg-brand-600 text-white p-12 text-center shadow-lg relative overflow-hidden">
            <div class="absolute inset-0 bg-brand-700 opacity-20 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white to-transparent"></div>
            <p class="text-xl max-w-3xl mx-auto leading-relaxed italic relative z-10 font-medium">
                "Cuando las autoridades y los funcionarios trabajan a favor del pueblo, el poco dinero que llega alcanza para todos."
            </p>
        </div>

    </div>
</section>