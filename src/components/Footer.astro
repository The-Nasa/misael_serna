---
const year = new Date().getFullYear();
---

<footer class="w-full bg-gray-900 text-gray-300 py-12">
  <div class="max-w-7xl mx-auto px-6">

    <div class="flex flex-col md:flex-row items-center justify-between gap-6">

      <div class="text-center md:text-left">
        <p class="font-bold text-white text-lg">Misael Serna Villar</p>
        <p class="text-sm text-gray-400 mt-1">
          Candidato a Alcalde por Aucayacu 2027-2030
        </p>
      </div>

      <nav class="flex flex-wrap gap-6 text-sm justify-center">
        <a href="#quien-es" class="hover:text-brand-400 transition-colors">Inicio</a>
        <a href="#participacion" class="hover:text-brand-400 transition-colors">Propuestas</a>
        <a href="#contacto" class="hover:text-brand-400 transition-colors">Contacto</a>
      </nav>

      <div class="flex gap-4">
        <a
          href="https://web.facebook.com/misael.sernavillar/?_rdc=1&_rdr"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-brand-600 transition-colors duration-200"
          aria-label="Facebook"
        >
          f
        </a>
        <a
          href="http://tiktok.com/@misael.serna"
          target="_blank"
          rel="noopener noreferrer"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-800 hover:bg-brand-600 transition-colors duration-200"
          aria-label="TikTok"
        >
          t
        </a>
      </div>

    </div>

    <div class="mt-10 pt-6 border-t border-gray-800 text-center text-xs text-gray-500">
      &copy; {year} Misael Serna Villar. Todos los derechos reservados.
    </div>

  </div>
</footer>

