---
// ContactoForm.astro
---
<section class="py-16 bg-transparent">
  <div class="max-w-5xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 bg-white rounded-3xl shadow-sm border border-brand-200 overflow-hidden">
      
      <!-- Información de contacto -->
      <div class="p-10 md:p-12 bg-brand-50 border-b md:border-b-0 md:border-r border-brand-200 flex flex-col justify-center">
        <h2 class="text-3xl font-extrabold text-brand-700 mb-6">Hablemos por Aucayacu</h2>
        <p class="text-gray-600 mb-8 leading-relaxed">¿Tienes una idea, sugerencia o quieres sumarte como voluntario a nuestra campaña? Escríbenos, estamos para escucharte.</p>
        
        <div class="space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-accent-600 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div>
              <p class="text-sm text-gray-500 font-semibold uppercase tracking-wider">WhatsApp Directo</p>
              <p class="text-lg font-bold text-gray-900">+51 935 449 430</p>
            </div>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-white rounded-full flex items-center justify-center text-brand-600 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <p class="text-sm text-gray-500 font-semibold uppercase tracking-wider">Local de Campaña</p>
              <p class="text-lg font-bold text-gray-900">Av. Principal 123, Aucayacu</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Contacto por WhatsApp -->
      <div class="p-10 md:p-12 flex flex-col justify-center gap-6">
        <div class="text-center">
          <p class="text-brand-700 font-bold text-lg mb-2">Contáctanos directamente</p>
          <p class="text-gray-500 text-sm">Escríbenos por WhatsApp y te respondemos a la brevedad.</p>
        </div>

        <a
          href="https://wa.me/51935449430"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-4 px-6 bg-[#25D366] hover:bg-[#1ebd5a] text-white font-bold rounded-xl shadow-md transition-colors flex items-center justify-center gap-3 text-lg"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
          <span>Escríbenos por WhatsApp</span>
        </a>

        <p class="text-center text-gray-400 text-xs">
          También puedes llamarnos al
          <a href="tel:+51935449430" class="text-brand-600 font-semibold hover:underline">+51 935 449 430</a>
        </p>
      </div>
    </div>
  </div>
</section>
