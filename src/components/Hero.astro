---
---

<section class="relative w-full min-h-[90vh] flex items-center overflow-hidden bg-gradient-to-b from-brand-50 to-transparent">
  <div class="max-w-7xl mx-auto px-6 py-16 grid md:grid-cols-2 gap-10 items-center">
    
    <!-- Texto -->
    <div class="order-2 md:order-1 text-center md:text-left">
      <p class="text-brand-600 font-semibold tracking-wide uppercase text-sm mb-3">
        Elecciones Municipales 2026
      </p>
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight text-gray-900">
        Misael Serna Villar
      </h1>
      <h2 class="mt-4 text-2xl md:text-3xl font-semibold text-brand-700">
        Alcalde por Aucayacu 2027-2030
      </h2>
      <p class="mt-6 text-gray-600 text-lg max-w-lg mx-auto md:mx-0">
        Ingeniero en Recursos Naturales Renovables, con Maestría en Gestión Pública 
        para el Desarrollo Social. Al servicio de Aucayacu.
      </p>

      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center md:justify-start">
        <a
          href="#quien-es"
          class="px-8 py-3 bg-accent-600 hover:bg-accent-700 text-white font-semibold rounded-full transition-colors duration-200 shadow-lg shadow-brand-200"
        >
          Conóceme
        </a>
        <a
          href="#contacto"
          class="px-8 py-3 border-2 border-brand-600 text-brand-700 hover:bg-brand-50 font-semibold rounded-full transition-colors duration-200"
        >
          Contáctame
        </a>
      </div>
    </div>

    <!-- Imagen -->
    <div class="order-1 md:order-2 flex justify-center">
      <div class="relative">
        <div class="absolute inset-0 bg-brand-500/10 rounded-3xl rotate-3 scale-105"></div>
        <img
          src="/images/misael-serna.jpg"
          alt="Misael Serna Villar"
          class="relative w-full max-w-md rounded-3xl shadow-2xl object-cover aspect-[4/5]"
        />
      </div>
    </div>

  </div>
</section>


