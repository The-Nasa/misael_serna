---
// Header.astro
// Header de campana con navegacion sticky, menu mobile y CTA.
import { candidato } from '../data/candidato';

export interface Props {
  nombre?: string;
  cargo?: string;
  numeroLista?: string;
  ctaTexto?: string;
  ctaHref?: string;
}

const {
  nombre = candidato.nombreCorto,
  cargo = candidato.cargo,
  numeroLista = candidato.numeroLista,
  ctaTexto = "Unete",
  ctaHref = "/#contacto",
} = Astro.props;

const currentPath = Astro.url.pathname;

// Detecta si un link es el activo (ignora el hash)
const isActive = (href: string): boolean => {
  const path = href.split('#')[0];
  if (path === '' || path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path + '/');
};

const navLinks = [
  { label: "Inicio", href: "/#inicio" },
  { label: "Propuestas", href: "/propuestas" },
  { label: "Equipo", href: "/equipo" },
  { label: "Sobre mí", href: "/sobre-mi" },
  { label: "Contacto", href: "/#contacto" },
];
---

<header class="site-header" id="site-header">
  <div class="header-inner">
    <a href="/" class="brand">
      <span class="brand-name">{nombre}</span>
      <span class="brand-role">{cargo}</span>
    </a>

    <nav class="nav-desktop" aria-label="Navegación principal">
      {navLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? "page" : undefined}
          class={isActive(link.href) ? "active" : ""}
        >{link.label}</a>
      ))}
    </nav>

    <div class="header-actions">

      <a href={ctaHref} class="cta">{ctaTexto}</a>

      <button
        class="menu-toggle"
        id="menu-toggle"
        aria-label="Abrir menú"
        aria-controls="nav-mobile"
        aria-expanded="false"
      >
        <span class="sr-only">Menú</span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="nav-mobile" aria-label="Navegación móvil" data-open="false">
    {navLinks.map((link) => (
      <a
        href={link.href}
        aria-current={isActive(link.href) ? "page" : undefined}
      >{link.label}</a>
    ))}
    <a href={ctaHref} class="cta cta-mobile">{ctaTexto}</a>
  </nav>
</header>

<style>
  .site-header {
    --ink: var(--color-brand-600);
    --paper: rgba(255, 255, 255, 0.95);
    --gold: var(--color-accent-600);
    --white: #ffffff;
    backdrop-filter: blur(8px);

    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid rgba(27, 42, 61, 0.12);
    transition: box-shadow 0.2s ease;
  }

  .site-header[data-scrolled="true"] {
    box-shadow: 0 4px 16px rgba(27, 42, 61, 0.12);
  }

  .header-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.85rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    text-decoration: none;
    color: var(--ink);
  }

  .brand-name {

    font-weight: 800;
    font-size: 1.65rem;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }

  .brand-role {

    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
    margin-top: 0.1rem;
  }

  .nav-desktop {
    display: none;
    gap: 1.75rem;

    font-weight: 600;
    font-size: 0.92rem;
  }

  .nav-desktop a {
    color: var(--ink);
    text-decoration: none;
    padding: 0.4rem 0.1rem;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s ease, opacity 0.15s ease, color 0.15s ease;
  }

  .nav-desktop a:hover,
  .nav-desktop a:focus-visible,
  .nav-desktop a.active,
  .nav-desktop a[aria-current="page"] {
    border-bottom-color: var(--gold);
    color: var(--gold);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .list-badge {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--white);
    border: 2px solid var(--gold);
    line-height: 1;
  }

  .list-badge-number {

    font-weight: 800;
    font-size: 1.15rem;
  }

  .list-badge-label {

    font-size: 0.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .cta {
    display: none;

    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
    color: var(--white);
    background: var(--ink);
    padding: 0.6rem 1.3rem;
    border-radius: 2px;
    border: 1px solid var(--ink);
    transition: background 0.15s ease, color 0.15s ease;
  }

  .cta:hover,
  .cta:focus-visible {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--ink);
  }

  .menu-toggle {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 32px;
    height: 32px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--ink);
    border-radius: 1px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    max-height: 0;
    overflow: hidden;
    background: var(--paper);
    border-top: 1px solid rgba(27, 42, 61, 0.12);
    transition: max-height 0.25s ease;
  }

  .nav-mobile[data-open="true"] {
    max-height: 420px;
  }

  .nav-mobile a {
    padding: 0.9rem 1.5rem;

    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid rgba(27, 42, 61, 0.08);
  }

  .cta-mobile {
    display: block;
    text-align: center;
    margin: 0.9rem 1.5rem;
    background: var(--ink);
    color: var(--white);
    border-radius: 2px;
  }

  @media (min-width: 860px) {
    .nav-desktop {
      display: flex;
    }
    .list-badge {
      display: flex;
    }
    .cta {
      display: inline-block;
    }
    .menu-toggle {
      display: none;
    }
    .nav-mobile {
      display: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const mobileNav = document.getElementById("nav-mobile");

  // Abrir / cerrar el menú mobile
  toggle?.addEventListener("click", () => {
    const isOpen = mobileNav?.dataset.open === "true";
    mobileNav?.setAttribute("data-open", String(!isOpen));
    toggle.setAttribute("aria-expanded", String(!isOpen));
    toggle.setAttribute("aria-label", !isOpen ? "Cerrar menú" : "Abrir menú");
  });

  // Cerrar menú mobile al hacer click en cualquier link (H1 Nielsen)
  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileNav.setAttribute("data-open", "false");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.setAttribute("aria-label", "Abrir menú");
    });
  });

  // Sombra al hacer scroll
  const onScroll = () => {
    header?.setAttribute("data-scrolled", window.scrollY > 8 ? "true" : "false");
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
</script>
