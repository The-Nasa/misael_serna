---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
}

const { title, description = "Misael Serna Villar - Candidato a Alcalde por Aucayacu 2027-2030" } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/logo.jpg" />
    <title>{title}</title>

    <!-- Tipografía del Manual: Avenir (Fallback web: Nunito Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
    
    <!-- GSAP & ScrollTrigger -->
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
  </head>
  <body class="bg-brand-50 text-gray-800 antialiased">
    <slot />

    <!-- Script de Animaciones GSAP -->
    <script is:inline>
      document.addEventListener("DOMContentLoaded", () => {
        gsap.registerPlugin(ScrollTrigger);

        const sections = document.querySelectorAll("section");
        
        sections.forEach((section) => {
          // Seleccionar elementos clave dentro de cada sección
          const elements = section.querySelectorAll("h1, h2, h3, h4, p, img, a, blockquote, .grid > div");
          
          if(elements.length > 0) {
            gsap.fromTo(elements, 
              { opacity: 0, y: 40 },
              {
                opacity: 1, 
                y: 0, 
                duration: 0.8, 
                stagger: 0.1,
                ease: "power3.out",
                scrollTrigger: {
                  trigger: section,
                  start: "top 85%", // Inicia la animación cuando la sección llega al 85% de la pantalla
                  toggleActions: "play none none reverse" // Hace que la animación se repita si subes y vuelves a bajar
                }
              }
            );
          }
        });
      });
    </script>

    <style is:global>
      /* Aplicar la fuente Avenir (Manual de Marca) a todo el proyecto */
      body {
        font-family: 'Avenir', 'Avenir Next', 'Nunito Sans', system-ui, sans-serif;
      }
    </style>
  </body>
</html>
