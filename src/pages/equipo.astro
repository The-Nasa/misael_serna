---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import EquipoGrid from '../components/EquipoGrid.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Equipo - Misael Serna Villar">
  <Header />
  
  <main id="main-content" class="w-full bg-gradient-to-b from-brand-50 to-transparent min-h-screen">
    <div class="max-w-4xl mx-auto px-6 text-center pt-10">
      <h1 class="text-5xl font-extrabold text-gray-900 mb-4 uppercase">EQUIPO PREPARADO PARA GOBERNAR</h1>
      <p class="text-xl text-gray-600 font-medium mb-12">La lista que acompaña al Ing. Misael Serna reúne experiencia, juventud, profesionalismo y compromiso con Aucayacu.</p>
    </div>
    <EquipoGrid />
  </main>

  <Footer />
</Layout>
